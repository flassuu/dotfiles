# Hand-writed by flassuu
# btop theme template

# Main background; leave empty only if you need terminal transparency
theme[main_bg]="#1e1e2e"

# Main text / titles
theme[main_fg]="#cdd6f4"
theme[title]="#cdd6f4"

# Highlight / shortcut color
theme[hi_fg]="#89b4fa"

# Selected item in process list
theme[selected_bg]="#45475a"
theme[selected_fg]="#89b4fa"

# Inactive / disabled text
theme[inactive_fg]="#7f849c"

# Text on top of graphs
theme[graph_text]="#f5e0dc"

# Meter background
theme[meter_bg]="#45475a"

# Misc text in processes box
theme[proc_misc]="#f5e0dc"

# Box outline colors
theme[cpu_box]="#cba6f7"
theme[mem_box]="#a6e3a1"
theme[net_box]="#f38ba8"
theme[proc_box]="#89b4fa"

# Divider line / small box lines
theme[div_line]="#6c7086"

# Temperature graph gradient
theme[temp_start]="#a6e3a1"
theme[temp_mid]="#fab387"
theme[temp_end]="#f38ba8"

# CPU graph gradient
theme[cpu_start]="#94e2d5"
theme[cpu_mid]="#89b4fa"
theme[cpu_end]="#cba6f7"

# Free memory/disk meter gradient
theme[free_start]="#cba6f7"
theme[free_mid]="#89b4fa"
theme[free_end]="#89b4fa"

# Cached memory/disk meter gradient
theme[cached_start]="#94e2d5"
theme[cached_mid]="#89b4fa"
theme[cached_end]="#89b4fa"

# Available memory/disk meter gradient
theme[available_start]="#fab387"
theme[available_mid]="#f38ba8"
theme[available_end]="#f38ba8"

# Used memory/disk meter gradient
theme[used_start]="#a6e3a1"
theme[used_mid]="#94e2d5"
theme[used_end]="#89b4fa"

# Download graph gradient
theme[download_start]="#fab387"
theme[download_mid]="#f38ba8"
theme[download_end]="#f38ba8"

# Upload graph gradient
theme[upload_start]="#a6e3a1"
theme[upload_mid]="#94e2d5"
theme[upload_end]="#89b4fa"

# Process box gradient
theme[process_start]="#94e2d5"
theme[process_mid]="#89b4fa"
theme[process_end]="#cba6f7"
