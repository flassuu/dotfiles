#!/usr/bin/env python3
"""Remember per-application window geometry for Hyprland (Lua config, 0.56+).

Canonical state : $XDG_STATE_HOME/hypr/window-state.json
Generated cache : $XDG_STATE_HOME/hypr/window-state.lua   (read by Hyprland)

The cache exists because Hyprland's Lua state has no JSON parser; it is
regenerated on every write.  Hyprland reads the cache on every `window.open`
event, so a new record is live immediately -- no `hyprctl reload` needed.

Which properties a record remembers is chosen at save time:
    -f  floating state        -s  size
    -p  position              -w  workspace
The key binding uses `-fsp`; without `-w` the workspace slot is written as
null, but it is always present in the JSON so it can be filled in by hand.
Unselected properties are written as null, so a re-save reflects exactly the
requested flags.  Restoring only applies non-null slots; workspace moves are
additionally gated by `config apply_workspace` (off by default):

    hypr-window-state config set apply_workspace true
"""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import html
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from typing import Any

TOOL = "hypr-window-state"
DEFAULT_CONFIG = {"apply_workspace": False, "settle_ms": 400, "notify": True}
PROPS = ("floating", "size", "position", "workspace")


# --------------------------------------------------------------------------- #
# Paths and state
# --------------------------------------------------------------------------- #

def state_dir() -> Path:
    override = os.environ.get("HYPR_WINDOW_STATE_DIR")
    if override:
        return Path(override).expanduser()
    base = os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state")
    return Path(base).expanduser() / "hypr"


def json_path() -> Path:
    return state_dir() / "window-state.json"


def lua_path() -> Path:
    return state_dir() / "window-state.lua"


def lock_path() -> Path:
    return state_dir() / "window-state.lock"


def empty_state() -> dict[str, Any]:
    return {"version": 1, "config": dict(DEFAULT_CONFIG), "records": {}}


def load_state() -> dict[str, Any]:
    path = json_path()
    if not path.exists():
        return empty_state()
    with path.open(encoding="utf-8") as fh:
        data = json.load(fh)
    if not isinstance(data, dict):
        raise SystemExit(f"{TOOL}: {path} is not a JSON object")
    data.setdefault("version", 1)
    config = data.setdefault("config", {})
    for key, value in DEFAULT_CONFIG.items():
        config.setdefault(key, value)
    records = data.setdefault("records", {})
    if not isinstance(records, dict):
        raise SystemExit(f"{TOOL}: 'records' must be an object")
    return data


def atomic_write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    with tmp.open("w", encoding="utf-8") as fh:
        fh.write(text)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, path)


@contextlib.contextmanager
def locked():
    path = lock_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


def save_state(state: dict[str, Any]) -> None:
    state["version"] = 1
    text = json.dumps(state, indent=2, ensure_ascii=False) + "\n"
    atomic_write(json_path(), text)
    atomic_write(lua_path(), generate_lua(state))


# --------------------------------------------------------------------------- #
# Lua cache generation
# --------------------------------------------------------------------------- #

def lua_bool(value: bool) -> str:
    return "true" if value else "false"


def lua_str(value: str) -> str:
    out = ['"']
    for ch in value:
        if ch == "\\":
            out.append("\\\\")
        elif ch == '"':
            out.append('\\"')
        elif ch == "\n":
            out.append("\\n")
        elif ch == "\r":
            out.append("\\r")
        elif ch == "\t":
            out.append("\\t")
        else:
            out.append(ch)
    out.append('"')
    return "".join(out)


def generate_lua(state: dict[str, Any]) -> str:
    config = state.get("config", {})
    lines = [
        "-- Generated by hypr-window-state from window-state.json.",
        "-- Do not edit this file: edit the JSON and run `hypr-window-state sync`.",
        "return {",
        "\tconfig = {",
        f"\t\tapply_workspace = {lua_bool(bool(config.get('apply_workspace')))},",
        f"\t\tsettle_ms = {int(config.get('settle_ms') or 0)},",
        "\t},",
        "\trecords = {",
    ]

    for key, rec in state.get("records", {}).items():
        fields = [
            f"key = {lua_str(key)}",
            f"class = {lua_str(rec.get('class') or '')}",
            f"initial_class = {lua_str(rec.get('initial_class') or rec.get('class') or '')}",
        ]
        if rec.get("xwayland") is not None:
            fields.append(f"xwayland = {lua_bool(bool(rec['xwayland']))}")
        if rec.get("variant"):
            fields.append("variant = true")
        if rec.get("title_exact") is not None:
            fields.append(f"title_exact = {lua_str(rec['title_exact'])}")
        if rec.get("title_pattern") is not None:
            fields.append(f"title_pattern = {lua_str(rec['title_pattern'])}")
        if rec.get("floating") is not None:
            fields.append(f"floating = {lua_bool(bool(rec['floating']))}")

        size = rec.get("size") or {}
        if size.get("w") and size.get("h"):
            fields.append(f"w = {int(size['w'])}")
            fields.append(f"h = {int(size['h'])}")

        pos = rec.get("position") or {}
        if pos.get("x") is not None and pos.get("y") is not None:
            fields.append(f"x = {int(pos['x'])}")
            fields.append(f"y = {int(pos['y'])}")
            fields.append(f"centered = {lua_bool(bool(pos.get('centered')))}")
            if pos.get("monitor"):
                fields.append(f"monitor = {lua_str(pos['monitor'])}")
            if pos.get("rel_x") is not None and pos.get("rel_y") is not None:
                fields.append(f"rel_x = {int(pos['rel_x'])}")
                fields.append(f"rel_y = {int(pos['rel_y'])}")

        workspace = rec.get("workspace") or {}
        if workspace.get("name"):
            fields.append(f"ws = {lua_str(workspace['name'])}")

        lines.append("\t\t{ " + ", ".join(fields) + " },")

    lines += ["\t},", "}", ""]
    return "\n".join(lines)


# --------------------------------------------------------------------------- #
# hyprctl helpers
# --------------------------------------------------------------------------- #

def hyprctl_json(*args: str) -> Any:
    try:
        proc = subprocess.run(
            ["hyprctl", "-j", *args],
            check=True,
            capture_output=True,
            text=True,
        )
    except FileNotFoundError:
        raise SystemExit(f"{TOOL}: hyprctl not found")
    except subprocess.CalledProcessError as exc:
        raise SystemExit(f"{TOOL}: hyprctl {' '.join(args)} failed: {exc.stderr.strip()}")
    try:
        return json.loads(proc.stdout or "null")
    except json.JSONDecodeError as exc:
        raise SystemExit(f"{TOOL}: invalid JSON from hyprctl {' '.join(args)}: {exc}")


def active_window() -> dict[str, Any] | None:
    data = hyprctl_json("activewindow")
    if isinstance(data, dict) and data.get("address"):
        return data
    return None


def window_by_address(address: str) -> dict[str, Any] | None:
    selector = address if address.startswith("0x") else f"0x{address}"
    for client in hyprctl_json("clients") or []:
        if client.get("address") == selector:
            return client
    return None


def get_window(address: str | None) -> dict[str, Any] | None:
    if address:
        window = window_by_address(address)
        if not window:
            raise SystemExit(f"{TOOL}: no window with address {address}")
        return window
    return active_window()


def clients() -> list[dict[str, Any]]:
    data = hyprctl_json("clients")
    return data if isinstance(data, list) else []


def monitors() -> list[dict[str, Any]]:
    data = hyprctl_json("monitors")
    return data if isinstance(data, list) else []


def monitor_of(window: dict[str, Any], mons: list[dict[str, Any]]) -> dict[str, Any] | None:
    for mon in mons:
        if mon.get("id") == window.get("monitor"):
            return mon
    return None


def monitor_logical_size(mon: dict[str, Any]) -> tuple[int, int]:
    scale = mon.get("scale") or 1
    return round(mon.get("width", 0) / scale), round(mon.get("height", 0) / scale)


# --------------------------------------------------------------------------- #
# Identity
# --------------------------------------------------------------------------- #

def norm(value: str | None) -> str:
    return re.sub(r"[^a-z0-9]", "", (value or "").lower())


def slug(value: str) -> str:
    out = re.sub(r"[^a-z0-9]+", "-", (value or "").lower()).strip("-")
    return out[:40].strip("-") or "variant"


def is_primary(window: dict[str, Any], all_clients: list[dict[str, Any]]) -> bool:
    """Heuristic: is this the application's main window rather than a popup?

    Two independent signals: the initial title resembles the app id, or the
    window is clearly the largest of its class.  Both are stable across runs;
    the live title is never used.
    """
    title = norm(window.get("initialTitle"))
    cls = norm(window.get("class"))
    icls = norm(window.get("initialClass"))

    if len(title) >= 3 and (
        (cls and (title in cls or cls in title)) or (icls and (title in icls or icls in title))
    ):
        return True

    size = window.get("size") or [0, 0]
    area = int(size[0]) * int(size[1])
    siblings = [
        client
        for client in all_clients
        if client.get("class") == window.get("class")
        and client.get("address") != window.get("address")
    ]
    if not siblings:
        return True
    largest = max(int((c.get("size") or [0, 0])[0]) * int((c.get("size") or [0, 0])[1]) for c in siblings)
    return area > largest * 1.15


def existing_key(state: dict[str, Any], window: dict[str, Any]) -> str | None:
    """Reuse an existing variant record with the same initial title.

    The class default is deliberately not reused here: a popup of the same
    application must not overwrite the main window's record just because it
    shares the class.  `is_primary` decides whether the default is used.
    """
    title = window.get("initialTitle") or ""
    cls = window.get("class") or ""
    for key, rec in state["records"].items():
        if rec.get("class") == cls and rec.get("variant") and rec.get("title_exact") == title:
            return key
    return None


def unique_key(records: dict[str, Any], base: str, title: str) -> str:
    if base not in records:
        return base
    if records[base].get("title_exact") == title:
        return base
    index = 2
    while f"{base}-{index}" in records:
        index += 1
    return f"{base}-{index}"


# --------------------------------------------------------------------------- #
# Matching (mirror of config/window-state.lua)
# --------------------------------------------------------------------------- #

LUA_CLASSES = {
    "a": "[A-Za-z]",
    "c": "[\\x00-\\x1f\\x7f]",
    "d": "\\d",
    "g": "[^\\s\\w\\x00-\\x1f\\x7f]",
    "l": "[a-z]",
    "p": "[!-/:-@\\[-`{-~]",
    "s": "\\s",
    "u": "[A-Z]",
    "w": "[A-Za-z0-9]",
    "x": "[0-9A-Fa-f]",
}


def lua_pattern_to_regex(pattern: str) -> str:
    """Best-effort conversion for `identify` only; Hyprland uses real Lua."""
    out: list[str] = []
    i = 0
    while i < len(pattern):
        ch = pattern[i]
        if ch == "%":
            i += 1
            if i >= len(pattern):
                out.append("%")
                break
            code = pattern[i]
            if code in LUA_CLASSES:
                out.append(LUA_CLASSES[code])
            elif code.upper() in LUA_CLASSES and code.isupper():
                # complement classes are not needed by this tool; approximate
                out.append(".")
            else:
                out.append(re.escape(code))
        elif ch == "-":
            out.append("*?")
        elif ch in ".^$()[]*+?":
            out.append(ch)
        else:
            out.append(re.escape(ch))
        i += 1
    return "".join(out)


def lua_find(haystack: str, pattern: str) -> bool:
    try:
        return re.search(lua_pattern_to_regex(pattern), haystack) is not None
    except re.error:
        return False


def score_record(rec: dict[str, Any], window: dict[str, Any]) -> float | None:
    cls = window.get("class") or ""
    icls = window.get("initialClass") or cls
    known = {rec.get("class"), rec.get("initial_class")}
    if cls not in known and icls not in known:
        return None

    pattern = rec.get("title_pattern")
    if pattern:
        if not lua_find(window.get("initialTitle") or "", pattern):
            return None
        score = 10.0 + len(pattern)
    elif rec.get("variant"):
        if rec.get("title_exact") != (window.get("initialTitle") or ""):
            return None
        score = 20.0
    else:
        score = 0.0

    if rec.get("xwayland") is not None and bool(rec["xwayland"]) != bool(window.get("xwayland")):
        score -= 0.5
    return score


def best_record(state: dict[str, Any], window: dict[str, Any]) -> tuple[str, dict[str, Any], float] | None:
    best: tuple[str, dict[str, Any], float] | None = None
    for key, rec in state["records"].items():
        score = score_record(rec, window)
        if score is None:
            continue
        if best is None or score > best[2]:
            best = (key, rec, score)
    return best


# --------------------------------------------------------------------------- #
# Save
# --------------------------------------------------------------------------- #

def selected_props(args: argparse.Namespace) -> set[str]:
    props = {name for name in PROPS if getattr(args, name)}
    if args.all:
        props |= set(PROPS)
    if not props:
        props = {"floating", "size", "position"}
    # Size and position only make sense for floating windows.
    if "size" in props or "position" in props:
        props.add("floating")
    return props


def build_record(
    window: dict[str, Any],
    mons: list[dict[str, Any]],
    props: set[str],
    variant: bool,
    title_pattern: str | None,
    previous: dict[str, Any] | None,
) -> dict[str, Any]:
    mon = monitor_of(window, mons)
    at = window.get("at") or [0, 0]
    size = window.get("size") or [0, 0]
    ws = window.get("workspace") or {}

    record: dict[str, Any] = {
        "kind": "variant" if variant else "default",
        "class": window.get("class") or "",
        "initial_class": window.get("initialClass") or window.get("class") or "",
        "xwayland": bool(window.get("xwayland")),
        "label": window.get("initialTitle") or window.get("title") or window.get("class") or "",
        "initial_title": window.get("initialTitle") or "",
        "variant": variant,
        "title_exact": window.get("initialTitle") or "",
        "title_pattern": title_pattern,
        "floating": None,
        "size": None,
        "position": None,
        "workspace": None,
        "updated_at": datetime.now().astimezone().isoformat(timespec="seconds"),
        "saves": int((previous or {}).get("saves") or 0) + 1,
    }

    if "floating" in props:
        record["floating"] = bool(window.get("floating"))

    if "size" in props:
        record["size"] = {"w": int(size[0]), "h": int(size[1])}

    if "position" in props and mon is not None:
        mon_w, mon_h = monitor_logical_size(mon)
        reserved = mon.get("reserved") or [0, 0, 0, 0]
        usable_x = mon.get("x", 0) + int(reserved[0])
        usable_y = mon.get("y", 0) + int(reserved[1])
        usable_w = mon_w - int(reserved[0]) - int(reserved[2])
        usable_h = mon_h - int(reserved[1]) - int(reserved[3])
        centered = (
            abs((int(at[0]) + int(size[0]) / 2) - (usable_x + usable_w / 2)) <= 12
            and abs((int(at[1]) + int(size[1]) / 2) - (usable_y + usable_h / 2)) <= 12
        )
        record["position"] = {
            "x": int(at[0]),
            "y": int(at[1]),
            "monitor": mon.get("name"),
            "mon_x": int(mon.get("x", 0)),
            "mon_y": int(mon.get("y", 0)),
            "rel_x": int(at[0]) - int(mon.get("x", 0)),
            "rel_y": int(at[1]) - int(mon.get("y", 0)),
            "centered": centered,
        }

    if "workspace" in props:
        record["workspace"] = {"id": ws.get("id"), "name": ws.get("name")}

    return record


def cmd_save(args: argparse.Namespace) -> int:
    window = get_window(args.address)
    if not window:
        return fail("No focused window")

    if int(window.get("fullscreen") or 0) != 0:
        return fail("Window is fullscreen; leave fullscreen first")

    if args.default and args.as_name:
        return fail("--default and --as are mutually exclusive")
    if args.default and args.title_pattern:
        return fail("--title-pattern only applies to a variant")

    props = selected_props(args)
    all_clients = clients()
    mons = monitors()

    with locked():
        state = load_state()
        records = state["records"]
        title = window.get("initialTitle") or ""

        if args.default:
            key, variant = window.get("class") or "", False
        elif args.as_name:
            key = unique_key(records, f"{window.get('class')}::{slug(args.as_name)}", title)
            variant = True
        else:
            key = existing_key(state, window)
            if key:
                variant = bool(records[key].get("variant"))
            elif is_primary(window, all_clients):
                key, variant = window.get("class") or "", False
            else:
                key = unique_key(records, f"{window.get('class')}::{slug(title)}", title)
                variant = True

        pattern = args.title_pattern
        if pattern is not None and not variant:
            return fail("--title-pattern only applies to a variant")

        record = build_record(window, mons, props, variant, pattern, records.get(key))
        records[key] = record

        if args.dry_run:
            payload = {"key": key, "record": record}
            print(json.dumps(payload, indent=2, ensure_ascii=False) if args.json else json.dumps(record, indent=2, ensure_ascii=False))
            return 0

        save_state(state)

    if args.json:
        print(json.dumps({"key": key, "record": record}, indent=2, ensure_ascii=False))
    else:
        print(f"saved {key}")

    if not args.quiet and (args.notify or state["config"].get("notify", True)):
        notify_save(key, record)

    return 0


def notify_save(key: str, record: dict[str, Any]) -> None:
    kind = "variant" if record.get("variant") else "default"
    lines = [f"key: {key}  ({kind})"]

    floating = record.get("floating")
    lines.append("floating: " + ("—" if floating is None else ("yes" if floating else "no")))

    size = record.get("size")
    lines.append("size: " + ("—" if not size else f"{size['w']}×{size['h']}"))

    pos = record.get("position")
    if not pos:
        lines.append("pos: —")
    elif pos.get("centered"):
        lines.append(f"pos: centered  ({pos.get('monitor')})")
    else:
        lines.append(
            f"pos: {pos['x']},{pos['y']}  ({pos.get('monitor')}, rel +{pos.get('rel_x')}+{pos.get('rel_y')})"
        )

    ws = record.get("workspace")
    lines.append("workspace: " + (str(ws.get("name")) if ws else "—  (not stored, use -w)"))

    title = record.get("label") or record.get("class") or "window"
    class_name = record.get("class") or ""
    body = "\n".join(html.escape(line, quote=False) for line in lines)
    notify(f"{title}  ({class_name})", body)


def notify(title: str, body: str) -> None:
    if not shutil.which("notify-send"):
        return
    try:
        subprocess.run(
            ["notify-send", "-a", TOOL, "-u", "normal", title, body],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def fail(message: str) -> int:
    print(f"{TOOL}: {message}", file=sys.stderr)
    notify("Window state not saved", html.escape(message, quote=False))
    return 1


# --------------------------------------------------------------------------- #
# Read-only commands
# --------------------------------------------------------------------------- #

def cmd_list(args: argparse.Namespace) -> int:
    state = load_state()
    records = state["records"]
    if args.json:
        print(json.dumps(state, indent=2, ensure_ascii=False))
        return 0

    if not records:
        print("no saved window states")
        return 0

    rows = []
    for key, rec in records.items():
        size = rec.get("size")
        pos = rec.get("position")
        ws = rec.get("workspace")
        rows.append(
            (
                key,
                "variant" if rec.get("variant") else "default",
                "—" if rec.get("floating") is None else ("yes" if rec["floating"] else "no"),
                "—" if not size else f"{size['w']}×{size['h']}",
                "—" if not pos else ("centered" if pos.get("centered") else f"{pos['x']},{pos['y']}"),
                "—" if not pos else str(pos.get("monitor") or "—"),
                "—" if not ws else str(ws.get("name")),
                str(rec.get("updated_at") or ""),
            )
        )

    headers = ("KEY", "KIND", "FLOAT", "SIZE", "POS", "MONITOR", "WS", "UPDATED")
    widths = [max(len(str(row[i])) for row in rows + [headers]) for i in range(len(headers))]
    line = "  ".join(str(headers[i]).ljust(widths[i]) for i in range(len(headers)))
    print(line)
    print("  ".join("-" * w for w in widths))
    for row in rows:
        print("  ".join(str(row[i]).ljust(widths[i]) for i in range(len(headers))))
    return 0


def cmd_show(args: argparse.Namespace) -> int:
    state = load_state()
    if args.key not in state["records"]:
        return fail(f"no record for {args.key}")
    print(json.dumps(state["records"][args.key], indent=2, ensure_ascii=False))
    return 0


def cmd_forget(args: argparse.Namespace) -> int:
    with locked():
        state = load_state()
        missing = [key for key in args.keys if key not in state["records"]]
        if missing:
            return fail("no record for " + ", ".join(missing))
        for key in args.keys:
            del state["records"][key]
        save_state(state)
    print("removed " + ", ".join(args.keys))
    return 0


def cmd_identify(args: argparse.Namespace) -> int:
    window = get_window(args.address)
    if not window:
        return fail("No focused window")
    state = load_state()
    match = best_record(state, window)

    summary = {
        "window": {
            "address": window.get("address"),
            "class": window.get("class"),
            "initial_class": window.get("initialClass"),
            "initial_title": window.get("initialTitle"),
            "title": window.get("title"),
            "xwayland": window.get("xwayland"),
            "floating": window.get("floating"),
            "at": window.get("at"),
            "size": window.get("size"),
        },
        "match": None,
    }
    if match:
        key, rec, score = match
        summary["match"] = {"key": key, "score": score, "kind": rec.get("kind")}
    if args.json:
        print(json.dumps(summary, indent=2, ensure_ascii=False))
        return 0

    w = summary["window"]
    print(f"window: {w['initial_title']!r} class={w['class']} xwayland={w['xwayland']}")
    print(f"        title={w['title']!r} floating={w['floating']} at={w['at']} size={w['size']}")
    if summary["match"]:
        m = summary["match"]
        print(f"match:  {m['key']}  ({m['kind']}, score {m['score']})")
    else:
        print("match:  none")
    return 0


def cmd_config(args: argparse.Namespace) -> int:
    with locked():
        state = load_state()
        config = state["config"]
        if args.action == "list" or not args.action:
            print(json.dumps(config, indent=2, ensure_ascii=False))
            return 0
        if args.action == "get":
            if args.key not in config:
                return fail(f"unknown option {args.key}")
            print(json.dumps(config[args.key]))
            return 0
        if args.action == "set":
            if args.key not in DEFAULT_CONFIG:
                return fail(f"unknown option {args.key}")
            if not args.value:
                return fail("missing value")
            config[args.key] = parse_value(args.value, DEFAULT_CONFIG[args.key])
            save_state(state)
            print(f"{args.key} = {json.dumps(config[args.key])}")
            return 0
    return fail("usage: config [list|get KEY|set KEY VALUE]")


def parse_value(raw: str, like: Any) -> Any:
    if isinstance(like, bool):
        if raw.lower() in ("1", "true", "yes", "on"):
            return True
        if raw.lower() in ("0", "false", "no", "off"):
            return False
        raise SystemExit(f"{TOOL}: expected a boolean, got {raw!r}")
    if isinstance(like, int):
        try:
            return int(raw)
        except ValueError:
            raise SystemExit(f"{TOOL}: expected an integer, got {raw!r}")
    return raw


def cmd_sync(args: argparse.Namespace) -> int:
    with locked():
        state = load_state()
        save_state(state)
    print(f"synced {json_path()} -> {lua_path()}")
    return 0


def cmd_doctor(args: argparse.Namespace) -> int:
    problems: list[str] = []
    try:
        state = load_state()
    except Exception as exc:  # noqa: BLE001 - report, do not traceback
        return fail(f"cannot read state: {exc}")

    known_monitors = {mon.get("name") for mon in monitors()}
    keys = set(state["records"])

    for key, rec in state["records"].items():
        if key != rec.get("key", key) and "key" in rec:
            problems.append(f"{key}: stale 'key' field")
        if rec.get("class") != key and not rec.get("variant"):
            problems.append(f"{key}: default record class is {rec.get('class')!r}")
        if rec.get("variant") and not rec.get("title_exact") and not rec.get("title_pattern"):
            problems.append(f"{key}: variant without title matcher")
        pos = rec.get("position") or {}
        if pos.get("monitor") and pos["monitor"] not in known_monitors:
            problems.append(f"{key}: saved monitor {pos['monitor']!r} is not connected")
        size = rec.get("size") or {}
        if size and (int(size.get("w") or 0) <= 0 or int(size.get("h") or 0) <= 0):
            problems.append(f"{key}: invalid size")

    # The generated cache must always match the JSON.
    expected = generate_lua(state)
    if lua_path().exists():
        current = lua_path().read_text(encoding="utf-8")
        if current != expected:
            problems.append("window-state.lua is stale; run `hypr-window-state sync`")

    lua_bin = shutil.which("lua") or shutil.which("lua5.4")
    if lua_bin and lua_path().exists():
        check = subprocess.run(
            [lua_bin, "-e", f"assert(loadfile({json.dumps(str(lua_path()))}))"],
            capture_output=True,
            text=True,
            check=False,
        )
        if check.returncode != 0:
            problems.append("generated Lua does not compile: " + check.stderr.strip())

    print(f"state: {json_path()} ({len(keys)} record(s))")
    print(f"cache: {lua_path()}")
    print(f"config: {json.dumps(state['config'], ensure_ascii=False)}")
    if problems:
        for problem in problems:
            print("warning: " + problem)
        return 1
    print("ok")
    return 0


def cmd_apply(args: argparse.Namespace) -> int:
    state = load_state()
    targets: list[str] = []
    if args.all:
        for client in clients():
            if best_record(state, client):
                targets.append(client.get("address"))
    else:
        window = get_window(args.address)
        if not window:
            return fail("No focused window")
        targets = [window.get("address")]

    applied = 0
    for address in targets:
        window = window_by_address(address)
        if not window:
            continue
        match = best_record(state, window)
        if not match:
            continue
        _, rec, _ = match
        program = lua_apply_program(rec, state["config"], window)
        if not program:
            continue
        proc = subprocess.run(["hyprctl", "eval", program], capture_output=True, text=True, check=False)
        if proc.returncode != 0 or proc.stdout.strip() not in ("ok", ""):
            print(f"apply {address}: {proc.stdout.strip() or proc.stderr.strip()}", file=sys.stderr)
            continue
        applied += 1
    print(f"applied to {applied} window(s)")
    return 0


def lua_apply_program(rec: dict[str, Any], config: dict[str, Any], window: dict[str, Any]) -> str:
    sel = f"address:{window.get('address')}"
    parts: list[str] = []
    if rec.get("floating") is not None and bool(window.get("floating")) != bool(rec["floating"]):
        action = "enable" if rec["floating"] else "disable"
        parts.append(f'hl.dispatch(hl.dsp.window.float({{ window = "{sel}", action = "{action}" }}))')

    floating = rec.get("floating")
    if floating is None:
        floating = bool(window.get("floating"))
    if floating:
        size = rec.get("size") or {}
        if size.get("w") and size.get("h"):
            parts.append(
                f'hl.dispatch(hl.dsp.window.resize({{ window = "{sel}", '
                f"x = {int(size['w'])}, y = {int(size['h'])}, relative = false }}))"
            )
        pos = rec.get("position") or {}
        if pos.get("centered"):
            parts.append(f'hl.dispatch(hl.dsp.window.center({{ window = "{sel}" }}))')
        elif pos.get("x") is not None:
            x, y = target_position(rec, window, mon=monitor_of(window, monitors()))
            parts.append(
                f'hl.dispatch(hl.dsp.window.move({{ window = "{sel}", x = {x}, y = {y}, relative = false }}))'
            )
    if config.get("apply_workspace") and (rec.get("workspace") or {}).get("name"):
        ws = lua_str(rec["workspace"]["name"])
        parts.append(
            f'hl.dispatch(hl.dsp.window.move({{ window = "{sel}", workspace = {ws}, follow = false }}))'
        )
    return "; ".join(parts)


def target_position(rec: dict[str, Any], window: dict[str, Any], mon: dict[str, Any] | None) -> tuple[int, int]:
    pos = rec.get("position") or {}
    if mon is None:
        return int(pos.get("x") or 0), int(pos.get("y") or 0)
    mon_w, mon_h = monitor_logical_size(mon)
    width = int((rec.get("size") or {}).get("w") or 100)
    x = int(mon.get("x", 0)) + int(pos.get("rel_x") or 0)
    y = int(mon.get("y", 0)) + int(pos.get("rel_y") or 0)
    x = max(int(mon.get("x", 0)) - width + 64, min(x, int(mon.get("x", 0)) + mon_w - 64))
    y = max(int(mon.get("y", 0)), min(y, int(mon.get("y", 0)) + mon_h - 64))
    return x, y


# --------------------------------------------------------------------------- #
# Argument parsing
# --------------------------------------------------------------------------- #

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=TOOL, description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command")

    save = sub.add_parser("save", help="remember the focused window")
    save.add_argument("-f", "--floating", action="store_true", help="remember the floating state")
    save.add_argument("-s", "--size", action="store_true", help="remember the window size")
    save.add_argument("-p", "--position", action="store_true", help="remember the window position")
    save.add_argument("-w", "--workspace", action="store_true", help="remember the workspace")
    save.add_argument("-a", "--all", action="store_true", help="remember everything (-f -s -p -w)")
    save.add_argument("--default", action="store_true", help="save as the application default")
    save.add_argument("--as", dest="as_name", metavar="NAME", help="save as a named variant")
    save.add_argument("--title-pattern", metavar="PATTERN", help="Lua pattern for a variant title")
    save.add_argument("--address", help="window address instead of the focused window")
    save.add_argument("--notify", action="store_true", help="force a notification")
    save.add_argument("--quiet", action="store_true", help="no notification")
    save.add_argument("--dry-run", action="store_true", help="print the record, do not write it")
    save.add_argument("--json", action="store_true", help="JSON output")
    save.set_defaults(func=cmd_save)

    listing = sub.add_parser("list", help="list saved records")
    listing.add_argument("--json", action="store_true")
    listing.set_defaults(func=cmd_list)

    show = sub.add_parser("show", help="print one record")
    show.add_argument("key")
    show.set_defaults(func=cmd_show)

    forget = sub.add_parser("forget", help="delete records")
    forget.add_argument("keys", nargs="+")
    forget.set_defaults(func=cmd_forget)

    identify = sub.add_parser("identify", help="explain which record matches a window")
    identify.add_argument("--address")
    identify.add_argument("--json", action="store_true")
    identify.set_defaults(func=cmd_identify)

    apply_cmd = sub.add_parser("apply", help="apply saved records to open windows")
    apply_cmd.add_argument("--address")
    apply_cmd.add_argument("--all", action="store_true")
    apply_cmd.set_defaults(func=cmd_apply)

    config = sub.add_parser("config", help="read or change settings")
    config.add_argument("action", nargs="?", choices=("list", "get", "set"))
    config.add_argument("key", nargs="?")
    config.add_argument("value", nargs="?")
    config.set_defaults(func=cmd_config)

    sync = sub.add_parser("sync", help="regenerate the Lua cache from the JSON")
    sync.set_defaults(func=cmd_sync)

    doctor = sub.add_parser("doctor", help="validate the state and the cache")
    doctor.set_defaults(func=cmd_doctor)

    return parser


def main(argv: list[str]) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        args = parser.parse_args([*argv, "save"] if argv else ["save"])
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
