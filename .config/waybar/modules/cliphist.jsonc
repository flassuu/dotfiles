    "custom/cliphist": {
        "format": "{}",
        "rotate": ${r_deg},
        "exec": "echo ; echo 󰅇 clipboard history",
        "on-click": "quickshell ipc -p ~/.config/quickshell/clipboard call clipboardPanel toggle",
        "on-click-right": "quickshell ipc -p ~/.config/quickshell/clipboard call clipboardPanel toggle",
        "on-click-middle": "quickshell ipc -p ~/.config/quickshell/clipboard call clipboardPanel toggle",
        "interval" : 86400, // once every day
        "tooltip": true
    },

