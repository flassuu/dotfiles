@import "~/.config/rofi/style.rasi"

* {
    background-color: transparent;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: center;
    width: 1000px;
    border-radius: 6px 6px 0px 0px;
    background-color: @background;
    padding: 0px;
    border: 2px 2px 0px 2px;
    border-color: @foreground;
}

mainbox {
    padding: 12px;
}

inputbar {
    background-color: @background-alt;
    border: 2px;
    border-radius: 8px;
    padding: 12px 16px;
    spacing: 8px;
    children: [entry];
    margin: 0 0 15px 0;
}

entry {
    placeholder: "Search wallpapers...";
    placeholder-color: @foreground;
    text-color: @foreground;
}

listview {
    lines: 2;
    columns: 4;
    fixed-height: true;
    spacing: 15px;
}

element {
    padding: 5px 5px 3px 5px;
    border-radius: 8px;
    background-color: @background-alt;
    orientation: vertical;
    cursor: pointer;
}

element selected {
    background-color: @selected;
}

element-icon {
    size: 200px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    margin: -34px;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: @foreground;
    padding: 3px 4px 4px 5px;
    margin: 0px;
    font: "JetBrains Mono Nerd Font 9";
}

element selected element-text {
    text-color: @background;
}
