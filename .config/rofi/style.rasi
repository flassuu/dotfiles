@import "~/.config/rofi/colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 12";
/*	font: "Symbols Nerd Font 12"; */
    background-color: transparent;
    text-color: @foreground;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: north;
    y-offset: calc(50% - 176px);
    width: 480;
    border-radius: 8px;
    background-color: @background;
}

window.dmenu {
    width: 600;
    y-offset: calc(50% - 200px);
}

window.window {
    width: 700;
    y-offset: calc(50% - 250px);
}

window.run, window.ssh {
    width: 400;
    y-offset: calc(50% - 120px);
}

mainbox {
    padding: 12px;
}

inputbar {
    background-color: @surface;
    border-color: @border;
    border: 2px;
    border-radius: 16px;
    padding: 4px 4px;
    spacing: 4px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @secondary;
}

entry {
    placeholder: "Search";
    placeholder-color: @tertiary;
    text-color: @foreground;
}

message {
    margin: 12px 0 0;
    border-radius: 16px;
    border-color: @surface;
    background-color: @surface;
}

textbox {
    padding: 8px 24px;
    text-color: @foreground;
}

listview {
    background-color: transparent;
    margin: 12px 0 0;
    lines: 8;
    columns: 1;
    fixed-height: false;
}

listview.dmenu {
    lines: 10;
    scrollbar: true;
}

listview.window {
    lines: 12;
    scrollbar: true;
}

listview.run, listview.ssh {
    lines: 6;
}

element {
    padding: 8px 16px;
    spacing: 8px;
    border-radius: 16px;
    text-color: @foreground;
}

element normal {
    background-color: transparent;
    text-color: @foreground;
}

element normal active {
    background-color: @surface;
    text-color: @primary;
}

element alternate {
    background-color: transparent;
    text-color: @foreground;
}

element alternate active {
    background-color: @surface;
    text-color: @primary;
}

element selected normal {
    background-color: @surface2;
    text-color: @primary;
}

element selected active {
    background-color: @primary;
    text-color: @background;
}

element urgent {
    background-color: @error;
    text-color: @primary;
}

element selected urgent {
    background-color: @error;
    text-color: @secondary;
}

element-icon {
    size: 1em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}

scrollbar {
    width: 4px;
    border: 0;
    handle-color: @border;
    handle-width: 4px;
    padding: 0;
}

configuration {
    display-drun: "";
    display-run: "";
    display-window: "";
    display-ssh: "";
    display-dmenu: "";
    drun-display-format: "{name}";
    window-format: "{w} {c} {t}";
}

error-message {
    padding: 12px;
    border: 2px solid;
    border-radius: 16px;
    border-color: @error;
    background-color: @background;
}

case-indicator {
    spacing: 0;
    text-color: @tertiary;
}

num-filtered-rows, num-rows {
    text-color: @tertiary;
}

mode-switcher {
    spacing: 0;
}

button {
    padding: 8px;
    text-color: @tertiary;
    border: 0px;
    border-radius: 8px;
}

button selected {
    background-color: @surface2;
    text-color: @primary;
}
